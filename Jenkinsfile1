pipeline {
    // Agent definition: Run the entire pipeline inside a Docker container
    // This 'docker:latest' container will serve as our Jenkins agent.
    // It's assumed to have the Docker CLI installed and access to the host's Docker daemon.
    agent any

    // Tools definition: Ensure Node.js is available if needed by the Dockerfiles
    // (though Dockerfiles generally manage their own Node.js installation within the image)
    tools {
        nodejs "Node 20" // Ensure 'Node 20' is configured in Jenkins Global Tool Configuration
    }

    environment {
        // DOCKER_ORG_NAME: Your Docker Hub username or organization name.
        // This will prefix the names of your Docker images.
        // IMPORTANT: Replace 'your-dockerhub-username' with your actual Docker Hub username.
        //DOCKER_ORG_NAME = "your-dockerhub-username"
        
        FRONTEND_DIR = 'frontend' // Path to your frontend application's directory
        BACKEND_DIR  = 'backend'  // Path to your backend application's directory
        CI = 'false' // Common environment variable for frontend builds to prevent warnings as errors

        
    }

    stages {
        stage('Checkout Source Code') {
            steps {
                script {
                    echo "Checking out Git repository..."
                    // 'checkout scm' fetches the source code from the Git repository
                    // configured in your Jenkins job. This includes your Dockerfiles.
                    checkout scm
                }
            }
        }

        stage('Build Docker Images') {
      steps {
        script {
          // Clean up old containers if they exist
          bat 'docker rm -f mern-backend || true'
          bat 'docker rm -f mern-frontend || true'

          // Dockerfiles handle npm install and frontend build — no separate Jenkins install steps needed
          bat "docker build -t mern-backend:latest ${BACKEND_DIR}"
          bat "docker build -t mern-frontend:latest ${FRONTEND_DIR}"
        }
      }
    }
       stage('Run Containers') {
      steps {
        script {
          // Start containers exposing required ports
          bat 'docker run -d --name mern-backend -p 4000:4000 mern-backend:latest'
          bat 'docker run -d --name mern-frontend -p 80:80 mern-frontend:latest'
        }
      }
    }
    }

    post {
        success {
            echo '✅ Docker images built and deployed successfully!'
        }
        failure {
            echo '❌ Pipeline failed. Check console output for details and error messages.'
            // You can add more advanced notifications here (e.g., email, Slack integration).
        }
        always {
            echo 'Pipeline finished.'
        }
    }
}
